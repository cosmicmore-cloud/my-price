    // 검색/필터
    const q = document.getElementById('q');
    const region = document.getElementById('region');
    const grid = document.getElementById('storeGrid');

    function normalize(s){ return (s||'').toLowerCase().replace(/\s+/g,' ').trim(); }

    function applyFilter(){
      const query = normalize(q.value);
      const r = region.value;

      grid.querySelectorAll('.store').forEach(card => {
        const kw = normalize(card.getAttribute('data-keywords'));
        const name = normalize(card.querySelector('.storeName')?.textContent);
        const hitQuery = !query || kw.includes(query) || name.includes(query);
        const hitRegion = (r === 'all') || (card.getAttribute('data-region') === r);
        card.style.display = (hitQuery && hitRegion) ? '' : 'none';
      });
    }
    q.addEventListener('input', applyFilter);
    region.addEventListener('change', applyFilter);

    // 지점 선택 시 폼 자동 입력
    document.addEventListener('click', (e) => {
