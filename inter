        padding: 30px;
        border-radius: 20px;
        position: relative;
        text-align: center;
    }

    .ajd-modal-close {
        position: absolute;
        top: 20px;
        right: 20px;
        background: none;
        border: none;
        font-size: 24px;
        cursor: pointer;
        color: #999;
    }

    .ajd-inp {
        width: 100%;
        padding: 14px;
        border: 1px solid #ddd;
        border-radius: 10px;
        margin-bottom: 10px;
        font-size: 1rem;
        background: #f9f9f9;
    }

    .ajd-btn-full {
        width: 100%;
        padding: 16px;
        background: var(--hsw-blue);
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        margin-top: 10px;
    }

    .ajd-modal-btns {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .ajd-modal-btns button {
        flex: 1;
        padding: 14px 0;
