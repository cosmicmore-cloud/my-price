    .ajd-modal-btns button:hover {
        opacity: 0.9;
    }

    .ajd-btn-submit-modal {
        background-color: #333;
        color: #fff;
    }

    .ajd-btn-kakao {
        background-color: #FEE500;
        color: #3C1E1E;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .ajd-top-container {
            margin-bottom: 20px;
        }

        .ajd-top-tabs {
            justify-content: flex-start;
        }

