    .ajd-top-tab.active {
        color: var(--hsw-blue);
        border-bottom: 3px solid var(--hsw-blue);
    }

    /* 2. Header */
    .ajd-header {
        text-align: center;
        margin-bottom: 30px;
        padding: 0 20px;
    }

    .ajd-header h2 {
        font-size: 1.8rem;
        font-weight: 800;
        margin-bottom: 8px;
        color: #111;
    }

    .ajd-header p {
        color: #888;
        font-size: 0.95rem;
